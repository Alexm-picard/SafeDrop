# SafeDrop environment variables (SR-11: every secret lives here or in the host's secret store, never in git).
# Copy to `.env` at the repository root and fill in values. `docker compose` reads this file for interpolation;
# `code/backend` also loads it via dotenv when run outside Docker.
# Per-environment values (local / staging on Render / production) are documented in README.md, never committed.

# --- Backend -------------------------------------------------------------------------------------
# development | test | production. Production hides stack traces and DB error text (SDD §6.5).
NODE_ENV=development
# Port the Express API listens on.
PORT=4000
# MongoDB connection string. Transactions require a replica set (local Compose: rs0; Atlas: always).
# Outside Docker against the Compose mongo: mongodb://localhost:27017/safedrop?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://mongo:27017/safedrop?replicaSet=rs0
# HMAC secret for the 15-minute access JWT. At least 32 random bytes: `openssl rand -base64 48`.
JWT_ACCESS_SECRET=
# Access-token lifetime (SR-4). Vercel/ms format: 15m, 1h ...
JWT_ACCESS_TTL=15m
# Refresh-token idle timeout: a session ends after this much inactivity (SR-4).
JWT_REFRESH_IDLE_TTL=30m
# Refresh-token absolute lifetime: a session always ends this long after login, regardless of activity.
JWT_REFRESH_ABSOLUTE_TTL=12h
# Comma-separated browser origins allowed by CORS and by the Origin check on state-changing requests (SR-14).
CORS_ORIGINS=http://localhost:5173
# true in any HTTPS environment (staging/production). false only for plain-http local development.
COOKIE_SECURE=false
# fatal | error | warn | info | debug
LOG_LEVEL=info
# Max failed auth attempts per IP per 15 minutes before 429 (SR-12). Optional; default 20.
RATE_LIMIT_AUTH_MAX=20
# Max organisations one IP may create per hour before 429 (SR-12, SCRUM-114). Optional; default 5.
# Unlike the auth limit this counts *successful* requests: POST /api/organizations is public and
# creates a tenant plus an admin account each time, so the successes are what has to be bounded.
RATE_LIMIT_ORG_CREATE_MAX=5
# Reverse-proxy hops to trust for the client IP (rate limiting, secure cookies). Render: 1. Optional; default 1 in production, 0 otherwise.
TRUST_PROXY=0
# The SPA's public URL. Password-reset links are built on it, so it must be where the app actually
# runs. No trailing slash; must be https in production.
APP_BASE_URL=http://localhost:5173
# How mail is delivered: console | resend | brevo. `console` sends nothing and logs the message
# (including the reset link), which is what local development and the test suite use.
MAIL_PROVIDER=console
# API key for that provider. Leave empty for `console`; required for any other value.
MAIL_API_KEY=
# The From address, which the provider must have verified. `Name <address>` is accepted.
MAIL_FROM=SafeDrop <no-reply@safedrop.local>
# How long a password-reset link stays valid (SCRUM-22).
PASSWORD_RESET_TTL=10m

# --- Microsoft Foundry (AI features, SCRUM-103) ----------------------------------------------------
# Off unless switched on. These are read only by the backend: the SPA never holds an AI key (SR-11).
# When FOUNDRY_ENABLED=true, the endpoint, key and deployment are all required and the app refuses to
# boot without them — a half-configured AI feature should fail at deploy, not at a user's first search.
FOUNDRY_ENABLED=false
# The agent's full endpoint URL from the Foundry portal, path included — the path names which agent
# and which protocol, e.g.
#   https://<resource>.services.ai.azure.com/api/projects/<project>/agents/<agent>/endpoint/protocols/openai/responses
FOUNDRY_ENDPOINT=
# Credential for that endpoint. Never commit a real value (SR-11).
# NOTE: project endpoints under services.ai.azure.com are commonly Entra-authenticated rather than
# key-authenticated — check what the portal offers for this agent before filling this in.
FOUNDRY_API_KEY=
# The agent name, used for logging and for correlating a call with the agent version that served it.
FOUNDRY_DEPLOYMENT=
# Sent as the `api-version` query parameter. REQUIRED by the agent endpoint — without it the request
# is refused with a 400 before the agent is reached. Note this is not the dated YYYY-MM-DD form used
# by Azure OpenAI deployment endpoints; the two surfaces version differently.
FOUNDRY_API_VERSION=v1
# Ceiling on a single call, in ms. A search box that hangs is worse than one that says it is down.
FOUNDRY_TIMEOUT_MS=10000

# --- Frontend ------------------------------------------------------------------------------------
# Base URL prefix for API calls. Leave empty: the SPA calls /api/* on its own origin (SDD §6.3, OD-1 Option A)
# and the Vite dev proxy / Vercel rewrite forward to the API.
VITE_API_BASE=
# Where the Vite dev-server proxy forwards /api/*. Compose sets http://backend:4000; outside Docker use localhost.
VITE_DEV_PROXY_TARGET=http://localhost:4000
